{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "required": ["id", "type", "title", "source_node", "sensitivity", "created_at"],
  "properties": {
    "id": {"type": "string"},
    "type": {
      "type": "string",
      "enum": ["review", "roadmap", "architecture", "decision", "session", "external", "node-status"]
    },
    "title": {"type": "string"},
    "source_node": {"type": "string"},
    "source_agent": {"type": "string"},
    "source_ref": {"type": "string"},
    "sensitivity": {
      "type": "string",
      "enum": ["public", "project-public", "internal-summary", "private-local-only", "secret-never-sync"]
    },
    "sync_status": {
      "type": "string",
      "enum": ["local-only", "ready-for-github", "synced-github", "ready-for-portal", "synced-portal"]
    },
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
